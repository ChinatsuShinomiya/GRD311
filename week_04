<section> 


<main> Brown Butter Pumpkin Cookies</main>

    <img src="./images/brown_butter_pumpkin_cookies.png" alt="Brown butter pumpkin cookies" class="butter_cookies"
    align:left>

    <style>
        .butter_cookies {
            padding: 20px;
            margin: 0 auto;
        }
    </style>

    <h3>
        <ul>
            <li> 1 cup (220g) unsalted butter </li>
            <li>1 1/2 cups (280g) dark brown sugar, packed </li>
            <li>1 large egg yolk</li>
            <li>3 tbsp pure maple syrup</li>
            <li>1 tsp vanilla extract </li>
            <li>1/3 cup (80g) pumpkin puree</li>
            <li>2 1/4 cups (280g) all purpose flour</li>
            <li>1 tsp baking soda</li>
            <li>1/2 tsp baking powder</li>
            <li>1/2 tsp salt</li>
            <li>1 1/2 tsp pumpkin pie spice</li>
            <li>1/2 tsp cinnamon </li>
        </ul>
    </h3>

    </section>



<br>



<section>

    <main> Cinnamon Crunch Swirled Banana Bread</main>
    <img src="./images/Screenshot 2026-10-02 at 1.31.56 PM.png" alt="Cinnamon Crunch Swirled Banana" class="banana_bread">
   
   <style>
        .banana_bread {
            padding: 25px;
            margin:0 auto;
        }
   </style>
   
    <h3>
        <ul>
        <li>1/4 cup granulated sugar</li>
        <li>2 teaspoons cinnamon</li>
        <li>4 overly ripe bananas, mashed</li>
        <li>1/4 cup melted salted butter or coconut oil</li>
        <li>1/4 pure maple syrup</li>
        <li>2 eggs, at room temperature</li>
        <li>2 teaspoons vanilla extract</li>
        <li>1 1/2 cup all-purpose flour</li>
        <li>1 1/2 teaspoons baking soda</li>
        <li>1 teaspoon salt</li>    
    </ul>
    </h3>
